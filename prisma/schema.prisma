generator client {
  provider = "prisma-client-js"
}

// Base Postgres (Neon, Supabase, Vercel Postgres…).
// DATABASE_URL : connexion « poolée » utilisée par le site.
// DATABASE_URL_UNPOOLED : connexion directe utilisée par les migrations.
// L'intégration Neon de Vercel crée ces deux variables automatiquement.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// Textes éditables du site (clé -> valeur). Les valeurs par défaut vivent
// dans src/lib/content.ts ; seules les modifications sont stockées ici.
// Clé nue = français, « en:clé » = anglais.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Les champs suffixés « En » contiennent la version anglaise ; vides, le
// site anglais affiche le texte français.
model Service {
  id            String   @id @default(cuid())
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  bullets       String   @default("") // une puce par ligne
  bulletsEn     String?
  position      Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Step {
  id            String   @id @default(cuid())
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  duration      String?
  durationEn    String?
  position      Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  nameEn      String?
  price       String
  priceEn     String?
  period      String?
  periodEn    String?
  tagline     String?
  taglineEn   String?
  features    String   @default("") // une ligne par avantage
  featuresEn  String?
  ctaLabel    String   @default("Demander un devis")
  ctaLabelEn  String?
  highlighted Boolean  @default(false)
  position    Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FaqItem {
  id         String   @id @default(cuid())
  question   String
  questionEn String?
  answer     String
  answerEn   String?
  position   Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  author    String
  company   String?
  role      String?
  roleEn    String?
  rating    Int      @default(5)
  title     String?
  titleEn   String?
  content   String
  contentEn String?
  source    String   @default("trustpilot") // trustpilot | google | direct
  url       String?
  avatarUrl String?
  date      DateTime @default(now())
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  website   String?
  message   String
  locale    String   @default("fr")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
