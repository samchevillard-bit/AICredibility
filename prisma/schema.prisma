generator client {
  provider = "prisma-client-js"
}

// SQLite en local (zéro configuration). Pour la production sur Vercel, passez
// le provider à "postgresql" et renseignez DATABASE_URL (Neon, Supabase…) :
// les modifications faites dans l'admin seront alors conservées durablement.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// Textes éditables du site (clé -> valeur). Les valeurs par défaut vivent
// dans src/lib/content.ts ; seules les modifications sont stockées ici.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  bullets     String   @default("") // une puce par ligne
  position    Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Step {
  id          String   @id @default(cuid())
  title       String
  description String
  duration    String?
  position    Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  price       String
  period      String?
  tagline     String?
  features    String   @default("") // une ligne par avantage
  ctaLabel    String   @default("Demander un devis")
  highlighted Boolean  @default(false)
  position    Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  position  Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  author    String
  company   String?
  role      String?
  rating    Int      @default(5)
  title     String?
  content   String
  source    String   @default("trustpilot") // trustpilot | google | direct
  url       String?
  avatarUrl String?
  date      DateTime @default(now())
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  website   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
